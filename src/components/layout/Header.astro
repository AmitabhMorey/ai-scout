---
import HeaderNavButtons from './HeaderNavButtons.vue';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/pulse', label: 'Pulse ⚡' },
  { href: '/models', label: 'Models' },
  { href: '/agents', label: 'Agents & IDEs' },
  { href: '/funding', label: 'Funding' },
  { href: '/papers', label: 'Research' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/';
  }
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 h-16">
    <!-- Brand Logo & Live Radar Status -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-baseline gap-2 group">
        <span class="font-serif-display text-xl font-medium tracking-tight text-foreground group-hover:text-amber-300 transition-colors">
          AI Scout
        </span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground px-1.5 py-0.5 rounded bg-card border border-border">
          v2.0
        </span>
      </a>

      <!-- Live Telemetry Pulse Dot -->
      <div class="hidden sm:flex items-center gap-1.5 pl-3 border-l border-border text-[11px] font-mono text-emerald-400">
        <span class="size-2 rounded-full bg-emerald-400 radar-dot"></span>
        <span class="hidden md:inline tracking-wider">LIVE INDEX</span>
      </div>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-3 py-1.5 rounded-md text-xs font-medium transition-all ${
            isActive(link.href)
              ? 'bg-card text-foreground border border-border shadow-xs'
              : 'text-muted-foreground hover:text-foreground hover:bg-card/50'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Action Islands (Search ⌘K, Watchlist, Submit) -->
    <div class="flex items-center gap-2">
      <HeaderNavButtons client:load />
    </div>
  </div>

  <!-- Mobile Navigation Bar -->
  <div class="md:hidden flex items-center gap-2 px-4 py-2 border-t border-border/60 bg-card/40 overflow-x-auto scrollbar-none">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`px-2.5 py-1 rounded text-xs whitespace-nowrap font-medium transition-colors ${
          isActive(link.href)
            ? 'bg-card text-foreground border border-border'
            : 'text-muted-foreground hover:text-foreground'
        }`}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>
