---
import Header from '@/components/layout/Header.astro';
import BreakingTicker from '@/components/layout/BreakingTicker.vue';
import Footer from '@/components/layout/Footer.astro';
import CommandPalette from '@/components/layout/CommandPalette.vue';
import WatchlistDrawer from '@/components/layout/WatchlistDrawer.vue';
import SubmitModal from '@/components/layout/SubmitModal.vue';
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Scout — Frontier AI Models, Agentic IDEs & Capital Intelligence',
  description = 'Continuous intelligence on frontier AI model launches, coding agents, agentic IDEs, and venture rounds.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google Fonts: Newsreader (Editorial Serif) & IBM Plex Sans (Utility Sans) & IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans antialiased flex flex-col selection:bg-amber-500/30 selection:text-amber-200">
    <div id="top"></div>
    <Header />
    <BreakingTicker client:load />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>

    <Footer />

    <!-- Global Interactive Vue Islands -->
    <CommandPalette client:idle />
    <WatchlistDrawer client:idle />
    <SubmitModal client:idle />
  </body>
</html>
